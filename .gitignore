# Planning artifacts. Not published, not part of the shipped product.
# The folder holds reasoning at a point in time. It is kept locally only.
docs/planning/

# Validation artifacts. Live test transcripts and reports from a run against
# an installed build. Development evidence, kept locally only.
docs/validation/

# Local development tools. Not published, not part of the shipped product.
# The quality gate, version bump, and probes run from the developer's working tree.
tools/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor and IDE settings
.vscode/
.idea/
*.swp
*~

# Node.js
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# Test and tool output
coverage/
*.log

# Local telemetry, when a sink writes a file beside the repository
notnativereviewer-telemetry.jsonl

# State carried across a reload: the user's own words, kept beside the audit log
notnativereviewer-state.json
notnativereviewer-state.json.tmp
