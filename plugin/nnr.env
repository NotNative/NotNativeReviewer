# NotNativeReviewer settings.
#
# This file sets the gate's test postures. The gate reads it at setup, from its own
# directory. A change needs a restart of OpenCode, as an install does.
#
# 1 = on, anything else = off.
# A forced close wins when both lines are 1.

# Deny every call. Use this to prove that the gate closes calls.
# Keep this at 0 for normal operation, so the reviewer decides each call.
NNR_FORCE_DENY=0

# Allow every call. Use this to prove that the gate can open calls.
NNR_FORCE_ALLOW=0

# How long the package and the read ledger survive a reload, in minutes.
# 120 = two hours from the user's last message. 0 = off: every reload is a cold start.
# The state file holds the user's own words. It is gitignored, an install carries it
# forward, and an uninstall deletes it.
NNR_STATE_TTL_MINUTES=120
